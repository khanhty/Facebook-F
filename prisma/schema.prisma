generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
  VIEWER
}

enum ChannelType {
  FACEBOOK_COMMENT
  MESSENGER
  WHATSAPP
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum StockMode {
  RESERVE_ON_ORDER
  DEDUCT_ON_CONFIRM
  DEDUCT_ON_PAYMENT
}

model Workspace {
  id                   String             @id @default(cuid())
  name                 String
  currency             String             @default("LAK")
  timezone             String             @default("Asia/Vientiane")
  language             String             @default("en")
  stockMode            StockMode          @default(RESERVE_ON_ORDER)
  reservationExpiryMin Int                @default(120)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  users                User[]
  channels             ConnectedChannel[]
  liveSessions         LiveSession[]
  products             Product[]
  orders               Order[]
  conversations        Conversation[]
  customers            Customer[]
  webhookEvents        WebhookEvent[]
  auditLogs            AuditLog[]
  aiSessions           AiSessionState[]
}

model User {
  id          String     @id @default(cuid())
  workspaceId String
  email       String     @unique
  name        String
  role        UserRole   @default(STAFF)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])
}

model ConnectedChannel {
  id                 String     @id @default(cuid())
  workspaceId        String
  type               ChannelType
  pageOrNumberId     String
  encryptedToken     String
  webhookSecret      String
  active             Boolean    @default(true)
  createdAt          DateTime   @default(now())
  workspace          Workspace  @relation(fields: [workspaceId], references: [id])
}

model LiveSession {
  id                  String    @id @default(cuid())
  workspaceId         String
  channelId           String
  liveSourceId        String
  keyword             String    @default("F")
  mergeDuplicateItems Boolean   @default(true)
  startedAt           DateTime  @default(now())
  endedAt             DateTime?
  workspace           Workspace @relation(fields: [workspaceId], references: [id])
}

model Product {
  id             String          @id @default(cuid())
  workspaceId    String
  sku            String
  name           String
  description    String?
  price          Decimal         @db.Decimal(12, 2)
  category       String?
  similarGroup   String?
  imageUrl       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id])
  variants       ProductVariant[]

  @@unique([workspaceId, sku])
}

model ProductVariant {
  id             String   @id @default(cuid())
  productId      String
  variantCode    String
  color          String?
  size           String?
  attributesJson Json?
  stockOnHand    Int      @default(0)
  lowStockAt     Int      @default(5)
  product        Product  @relation(fields: [productId], references: [id])

  @@unique([productId, variantCode])
}

model Customer {
  id                  String        @id @default(cuid())
  workspaceId         String
  name                String?
  phone               String?
  address             String?
  facebookScopedId    String?
  messengerScopedId   String?
  whatsappWaId        String?
  createdAt           DateTime      @default(now())
  workspace           Workspace     @relation(fields: [workspaceId], references: [id])
  conversations       Conversation[]
}

model Conversation {
  id                  String        @id @default(cuid())
  workspaceId         String
  customerId          String
  channel             ChannelType
  externalThreadId    String
  aiEnabled           Boolean       @default(true)
  humanHandoff        Boolean       @default(false)
  tags                String[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  workspace           Workspace     @relation(fields: [workspaceId], references: [id])
  customer            Customer      @relation(fields: [customerId], references: [id])
  messages            Message[]
  aiState             AiSessionState?

  @@unique([workspaceId, channel, externalThreadId])
}

model Message {
  id                String       @id @default(cuid())
  conversationId    String
  direction         String
  content           String
  rawPayload        Json
  externalMessageId String?
  createdAt         DateTime     @default(now())
  conversation      Conversation @relation(fields: [conversationId], references: [id])
}

model Order {
  id                 String        @id @default(cuid())
  workspaceId        String
  customerId         String?
  channel            ChannelType
  status             OrderStatus   @default(NEW)
  paymentMethod      String?
  paymentStatus      PaymentStatus @default(PENDING)
  subtotal           Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee        Decimal       @default(0) @db.Decimal(12, 2)
  discount           Decimal       @default(0) @db.Decimal(12, 2)
  total              Decimal       @default(0) @db.Decimal(12, 2)
  linkedSourceId     String?
  note               String?
  shippingAddress    String?
  trackingNumber     String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  workspace          Workspace     @relation(fields: [workspaceId], references: [id])
  customer           Customer?     @relation(fields: [customerId], references: [id])
  items              OrderItem[]
  reservations       StockReservation[]
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String
  variantId       String?
  sku             String
  title           String
  qty             Int
  unitPrice       Decimal  @db.Decimal(12, 2)
  lineTotal       Decimal  @db.Decimal(12, 2)
  order           Order    @relation(fields: [orderId], references: [id])
}

model StockReservation {
  id              String    @id @default(cuid())
  workspaceId     String
  orderId         String
  productId       String
  variantId       String?
  qty             Int
  expiresAt       DateTime
  releasedAt      DateTime?
  workspace       Workspace @relation(fields: [workspaceId], references: [id])
  order           Order     @relation(fields: [orderId], references: [id])
}

model WebhookEvent {
  id               String    @id @default(cuid())
  workspaceId      String
  source           String
  idempotencyKey   String
  payload          Json
  status           String    @default("PENDING")
  retries          Int       @default(0)
  createdAt        DateTime  @default(now())
  processedAt      DateTime?
  workspace        Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, source, idempotencyKey])
}

model OutgoingLog {
  id                String   @id @default(cuid())
  workspaceId       String
  channel           ChannelType
  destinationId     String
  payload           Json
  status            String
  retries           Int      @default(0)
  createdAt         DateTime @default(now())
}

model AiSessionState {
  id                String       @id @default(cuid())
  workspaceId       String
  conversationId    String       @unique
  currentStep       String
  confidence        Float        @default(0)
  stateJson         Json
  updatedAt         DateTime     @updatedAt
  workspace         Workspace    @relation(fields: [workspaceId], references: [id])
  conversation      Conversation @relation(fields: [conversationId], references: [id])
}

model AuditLog {
  id                String    @id @default(cuid())
  workspaceId       String
  actorUserId       String?
  action            String
  entityType        String
  entityId          String
  metadata          Json?
  createdAt         DateTime  @default(now())
  workspace         Workspace @relation(fields: [workspaceId], references: [id])
}
